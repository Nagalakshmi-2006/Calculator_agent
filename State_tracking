def oda_loop(max_iters=10):
    state = {
        "done": False,
        "steps": 0
    }

    for i in range(1, max_iters + 1):
        # Observe
        temperature = float(input("Enter temperature: "))
        state["steps"] += 1

        print(f"\nIteration {i}")
        print(f"Observe: {temperature}°C")

        # Decide
        if temperature > 30:
            decision = "Turn ON the fan"
        else:
            decision = "Keep the fan OFF"

        print(f"Decide: {decision}")

        # Act
        print(f"Act: {decision}")

        # Success condition
        if 20 <= temperature <= 30:
            state["done"] = True
            return state

    # Maximum iterations exceeded
    return {
        **state,
        "result": "failure"
    }


state = oda_loop(max_iters=10)

print("\nFinal state:")
print(state)
